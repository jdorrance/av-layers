  "policy": {
    "id": "soaring-land-v1",
    "latMin": -55,
    "latMax": 65,
    "seaBufferMeters": 50000,
    "bufferMethod": "10-degree tiles; source clipped to tile plus 4deg lon/2deg lat; per-tile WGS84 azimuthal-equidistant local metric projection; 50 km planar buffer with 16 quad segments; inverse-projected and clipped to the 10-degree core; antimeridian shifted and split at +/-180. No global LAEA or degree buffer.",
    "excludedPrecedence": "An output cell is cleared if its nearest-cell footprint intersects the filled raw ADM0 footprint of RUS, ATA or GRL, even when that removes a buffer strip outside the excluded polygon.",
    "inlandLakes": "Interior rings of admitted country polygons are filled before buffering, so inland lakes and enclosed water remain included.",
    "cellFootprint": "GFS regular-grid nearest-cell rectangle: longitude center +/-0.125deg (periodic at +/-180), latitude center +/-0.125deg, clipped to -55..65. A cell is output-active when this rectangle intersects the admitted buffered geometry and does not intersect an excluded footprint.",
    "tileRule": "A z0-7 XYZ bit is set iff the tile's exact EPSG:4326 Web-Mercator lon/lat bounding box intersects at least one active cell footprint; tile centers are not tested.",
    "outputDomain": "union of admitted nearest-cell footprints clipped to the latitude band"
  },

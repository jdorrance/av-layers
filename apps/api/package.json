{
  "name": "@av/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var AV_LOCAL_DEVELOPMENT:true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\" && wrangler deploy --dry-run --env staging --outdir dist"
  },
  "dependencies": {
    "@av/contracts": "workspace:*",
    "@av/forecast": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.14",
    "pmtiles": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}

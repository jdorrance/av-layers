{
  "name": "windy-av-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "windy-av-layer"
    }
  ],
  "ratelimits": [
    {
      "name": "SAMPLE_RATE_LIMITER",
      "namespace_id": "78190301",
      "simple": {
        "limit": 100000,
        "period": 10
      }
    }
  ],
  "env": {
    "staging": {
      "name": "windy-av-api-staging",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "windy-av-layer-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "SAMPLE_RATE_LIMITER",
          "namespace_id": "78190302",
          "simple": {
            "limit": 100000,
            "period": 10
          }
        }
      ],
      "vars": {
        "AV_REQUEST_METRICS": "true",
        "AV_RESPONSE_CACHE": "on"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true
      }
    },
    "production": {
      "name": "windy-av-api-production",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "windy-av-layer"
        }
      ],
      "ratelimits": [
        {
          "name": "SAMPLE_RATE_LIMITER",
          "namespace_id": "78190303",
          "simple": {
            "limit": 100000,
            "period": 10
          }
        }
      ],
      "vars": {
        "AV_REQUEST_METRICS": "true",
        "AV_RESPONSE_CACHE": "on"
      }
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  }
}

{
  "name": "windy-av-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.23.4",
    "pnpm": "10.34.9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "refinement": "node --import tsx apps/batch/src/refinement/cli.ts",
    "refinement:evaluate": "node --import tsx apps/batch/src/refinement/evaluate.ts",
    "terrain": "node --import tsx apps/batch/src/terrain/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @av/api typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "pnpm --filter @av/preview build && pnpm --filter @av/api build",
    "forecast": "node --import tsx apps/batch/src/cli.ts build",
    "capacity": "node --import tsx apps/batch/src/cli.ts capacity",
    "input:proof": "node --import tsx apps/batch/src/cli.ts input-proof",
    "sample-preview": "node --import tsx scripts/sample-preview.ts",
    "dev": "node --import tsx scripts/dev-fixture.ts",
    "masks:build": "uv run --python 3.12 --with shapely==2.1.2 --with pyproj==3.7.2 --with pyshp==2.3.1 python scripts/masks/build_masks.py",
    "tools:pmtiles": "node scripts/setup-pmtiles.mjs",
    "docs:generate": "node --import tsx scripts/generate-reference.ts",
    "docs:check": "node --import tsx scripts/generate-reference.ts --check",
    "operations": "node --import tsx scripts/operations.ts",
    "health": "node --import tsx scripts/monitor-health.ts",
    "verify": "node scripts/setup-pmtiles.mjs --check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm docs:check && pnpm build && git diff --check"
  },
  "devDependencies": {
    "@av/client": "workspace:*",
    "@av/contracts": "workspace:*",
    "@av/forecast": "workspace:*",
    "@av/soaring": "workspace:*",
    "@av/solar": "workspace:*",
    "@av/thermodynamics": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "22.19.15",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "yaml": "2.9.1"
  }
}
